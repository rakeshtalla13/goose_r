<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gram" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_blue_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Gram.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/brand_blue</item>
        <item name="titleTextStyle">@style/Gram.ActionBar.Title</item>
    </style>

    <style name="Gram.ActionBar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Transparent activity for bottom sheet -->
    <style name="Theme.Gram.BottomSheet" parent="Theme.MaterialComponents.DayNight.Dialog.Bridge">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
