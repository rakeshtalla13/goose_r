#!/bin/sh
# Gradle wrapper — POSIX compatible (Gradle 8.x standard script)

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
MAX_FD=maximum

warn() { echo "$*"; } >&2
die()  { echo; echo "$*"; echo; exit 1; } >&2

# Resolve APP_HOME (follow symlinks)
app_path=$0
while [ -h "$app_path" ]; do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
        /*)  app_path=$link ;;
        *)   app_path=${app_path%"${app_path##*/}"}$link ;;
    esac
done
APP_HOME=$( cd "${app_path%"${app_path##*/}"}." && pwd -P ) || exit

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Locate java
if [ -n "$JAVA_HOME" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    [ -x "$JAVACMD" ] || die "ERROR: JAVA_HOME points to an invalid directory: $JAVA_HOME"
else
    JAVACMD=java
    command -v java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command found in PATH."
fi

# Raise FD limit where possible
case $( uname ) in Darwin*|CYGWIN*|MSYS*|NONSTOP*) ;; *)
    case $MAX_FD in
        max*) MAX_FD=$( ulimit -H -n ) || warn "Could not query max FD limit" ;;
    esac
    case $MAX_FD in ''|soft) ;; *)
        ulimit -n "$MAX_FD" || warn "Could not set max FD limit to $MAX_FD"
    esac
esac

set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

# Use xargs to properly split the quoted JVM opts
command -v xargs >/dev/null 2>&1 || die "xargs is not available"

eval "set -- $(
    printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
    xargs -n1 |
    sed 's~[^a-zA-Z0-9/=@_.-]~\\&~g' |
    tr '\n' ' '
) $*"

exec "$JAVACMD" "$@"
